{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "preserve",
    "types": ["node"],
    // The one path alias: Keystatic writes cover paths with a fixed prefix, and articles
    // sit at different folder depths, so a relative path would not resolve for all of them.
    "paths": { "@assets/*": ["./src/assets/*"] }
  }
}