# Copy to .env and fill in. Validated at build time by src/core/schemas/envSchema.ts.

# --- EmailJS (contact form) — all three, or none to fall back to mailto: ---
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=

# --- Keystatic CMS ---
# "local" (default) edits src/content directly via `npm run dev:cms`.
# "github" commits through the GitHub App; set it in Vercel to deploy /keystatic.
PUBLIC_KEYSTATIC_STORAGE=local

# Created by Keystatic's own setup flow at /keystatic in GitHub mode.
# Required on Vercel when PUBLIC_KEYSTATIC_STORAGE=github. Never commit the real values.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
