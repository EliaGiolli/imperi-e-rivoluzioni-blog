---
import Footer from "../../components/Footer.astro";
import Navbar from "../../components/Navbar.astro";
import SmoothScroll from "../../components/SmoothScroll.astro";
import "../styles/global.css";

import { BLOG_NAME } from "../utils/constants";
---

<html lang="it" class="bg-[#f6f4ee] text-[#17252b]">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/logo.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Portfolio di Elia Giolli, tecnico IT Support specializzato in troubleshooting, networking e infrastrutture." />
		<title>{BLOG_NAME}</title>
	</head>
	<body class="min-h-screen bg-[#f6f4ee] text-[#17252b]">
		<Navbar />
		<SmoothScroll />
		<slot />
		<Footer />
	</body>
</html>
