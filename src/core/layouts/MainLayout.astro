---
import Footer from "../../shared/components/Footer.astro";
import Navbar from "../../shared/components/Navbar.astro";
import SmoothScroll from "../../shared/components/SmoothScroll.astro";
import "../../styles/global.css";

import { BLOG_NAME } from "../../shared/utils/constants";
---

<html lang="it" class="bg-stone-100 text-stone-900">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Portfolio di Elia Giolli, tecnico IT Support specializzato in troubleshooting, networking e infrastrutture." />
		<title>{BLOG_NAME}</title>
	</head>
	<body class="min-h-screen bg-stone-100 text-stone-900">
		<Navbar />
		<SmoothScroll />
		<slot />
		<Footer />
	</body>
</html>
