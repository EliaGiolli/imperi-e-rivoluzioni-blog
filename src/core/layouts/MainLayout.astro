---
import { ClientRouter } from "astro:transitions";
import Analytics from "@vercel/analytics/astro";

import Footer from "../../shared/components/Footer.astro";
import Navbar from "../../shared/components/Navbar.astro";
import "../../styles/global.css";

import type { MainLayoutProps } from "../../shared/types";
import {
	BLOG_DESCRIPTION,
	BLOG_LOCALE,
	BLOG_NAME,
	OG_IMAGE_HEIGHT,
	OG_IMAGE_PATH,
	OG_IMAGE_WIDTH,
} from "../../shared/utils/constants";

type Props = MainLayoutProps;

const {
	title = BLOG_NAME,
	description = BLOG_DESCRIPTION,
	ogType = "website",
	publishedTime,
	modifiedTime,
	noindex = false,
} = Astro.props;

// Pages pass their own part of the title; the blog name is appended once. The homepage
// already carries it, so the check keeps it from being repeated.
const pageTitle = title.includes(BLOG_NAME) ? title : `${title} | ${BLOG_NAME}`;

// Astro.site comes from astro.config.mjs. Falling back to Astro.url keeps `astro dev`
// and any future preview deployment from emitting a canonical pointing at production.
const siteUrl = Astro.site ?? new URL(Astro.url.origin);

// Astro emits directory-style routes, and both the sitemap and the RSS feed link them
// with a trailing slash. The canonical has to agree, or the two disagree about which
// URL is the real one.
const path = Astro.url.pathname.replace(/\/+$/, "");
const canonicalUrl = new URL(path === "" ? "/" : `${path}/`, siteUrl);
const ogImageUrl = new URL(OG_IMAGE_PATH, siteUrl);
---

<html lang="it" class="bg-stone-100 text-stone-900 dark:bg-stone-900 dark:text-stone-100">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="color-scheme" content="light dark" />

		{/*
			Runs before the first paint so the stored theme is applied without a flash of the
			wrong palette. It is deliberately inline and dependency-free; the Alpine store in
			Navbar takes over once the page is interactive.
		*/}
		<script is:inline>
			(() => {
				try {
					const stored = localStorage.getItem("theme");
					const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
					document.documentElement.classList.toggle("dark", stored ? stored === "dark" : prefersDark);
				} catch {
					// localStorage throws in some privacy modes; the light theme is the safe fallback.
				}
			})();
		</script>

		{/*
			Google Fonts as <link> rather than an @import in global.css: the two preconnects
			open the font connections in parallel with the CSS request instead of after it.
		*/}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800;900&family=Special+Elite&display=swap"
		/>

		<ClientRouter />

		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl.href} />
		{noindex && <meta name="robots" content="noindex, follow" />}
		<link rel="alternate" type="application/rss+xml" title={`${BLOG_NAME} — Articoli`} href="/rss.xml" />

		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={BLOG_NAME} />
		<meta property="og:locale" content={BLOG_LOCALE} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl.href} />
		<meta property="og:image" content={ogImageUrl.href} />
		<meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
		<meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
		<meta property="og:image:alt" content={`${BLOG_NAME} — storia contemporanea e geopolitica`} />
		{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
		{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl.href} />

		<Analytics />

		<slot name="head" />
	</head>
	<body class="min-h-screen bg-stone-100 text-stone-900 dark:bg-stone-900 dark:text-stone-100">
		<Navbar />
		<slot />
		<Footer />
	</body>
</html>
