---
import { Image } from "astro:assets";
import { BLOG_NAME, LOGO_ALT_TEXT } from "../../shared/utils/constants";
import "../../styles/global.css";
---

<html lang="it" class="bg-stone-100 text-stone-900">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Curriculum vitae di Elia Giolli, tecnico IT Support e help desk." />
		<title>{BLOG_NAME}</title>
	</head>
	<body class="min-h-screen bg-stone-100 text-stone-900">
		<header class="border-b border-stone-700 bg-stone-900 text-white">
			<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4 lg:px-8">
				<a href="/" aria-label="Torna alla home" class="flex items-center gap-3 rounded-full px-2 py-1.5 text-white transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700 focus-visible:ring-offset-2 focus-visible:ring-offset-stone-900">
					<div class="flex h-12 w-12 items-center justify-center overflow-hidden rounded-full border border-white/15 bg-white/5 shadow-sm shadow-black/20">
						<Image src="/logo.svg" width={44} height={44} alt={LOGO_ALT_TEXT} class="h-full w-full object-contain" />
					</div>
					<div class="hidden sm:block">
						<div class="text-[10px] font-semibold uppercase tracking-[0.2em] text-stone-300">Portfolio</div>
						<div class="text-base font-bold text-white">Elia Giolli</div>
					</div>
				</a>

				<a href="/" class="inline-flex items-center rounded-full bg-amber-700 px-4 py-2 text-sm font-semibold text-stone-900 transition-colors hover:bg-amber-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700 focus-visible:ring-offset-2 focus-visible:ring-offset-stone-900">
					Torna alla home
				</a>
			</div>
		</header>

		<slot />
	</body>
</html>
