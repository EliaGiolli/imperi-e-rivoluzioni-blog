---
import { Image } from "astro:assets";

import { LOGO_ALT_TEXT } from '../utils/constants'
---

<header class="border-b border-indigo-600 bg-slate-50/80">
	<div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 max-[520px]:flex-col max-[520px]:items-start max-[520px]:gap-3">
		<a class="flex items-center text-xl font-bold text-indigo-600 no-underline" href="/" aria-label="Homepage">
            <Image src="/public/logo.svg" width={60} height={60} alt={LOGO_ALT_TEXT} />
            <h1 class="hidden" aria-label="main-title">Portfolio Elia Giolli</h1>
        </a>
		<nav aria-label="Main navigation">
			<ul class="flex list-none gap-6 p-0 max-[520px]:gap-4">
				<li><a class="text-neutral-900 no-underline hover:text-indigo-600 focus-visible:text-indigo-600" href="/about">Su di me</a></li>
				<li><a class="text-neutral-900 no-underline hover:text-indigo-600 focus-visible:text-indigo-600" href="/blog">Progetti</a></li>
				<li><a class="text-neutral-900 no-underline hover:text-indigo-600 focus-visible:text-indigo-600" href="/blog">Certificati</a></li>
				<li><a class="text-neutral-900 no-underline hover:text-indigo-600 focus-visible:text-indigo-600" href="/contact">Contatti</a></li>
			</ul>
			<!-- Selector for multi-language -->

			<!-- Mobile menu  -->
		</nav>
	</div>
</header>
