---
import type { VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";
import { button } from "../utils/variants";

interface Props extends VariantProps<typeof button> {
  href?: string;
  type?: "button" | "submit" | "reset";
  class?: string;
}

const { href, variant, size, type = "button", class: extraClass, ...rest } = Astro.props;

// Tag dinamico: se c'è href, renderizza <a>, altrimenti <button>
const Tag = href ? "a" : "button";
---

<Tag
  href={href}
  type={href ? undefined : type}
  class={cn(button({ variant, size }), extraClass)}
  {...rest}
>
  <slot />
</Tag>