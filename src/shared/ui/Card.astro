---
interface Props {
	as?: "div" | "article" | "section";
	class?: string;
	[key: string]: unknown;
}

const { as = "div", class: extraClass, ...attributes } = Astro.props;
const Tag = as;
---

<Tag
	class:list={["rounded-2xl border border-[#d9d6cb] bg-white shadow-[8px_8px_0_#ebe9e1]", extraClass]}
	{...attributes}
>
	<slot />
</Tag>
