---
interface Props {
	as?: "div" | "article" | "section";
	class?: string;
	[key: string]: unknown;
}

const { as = "div", class: extraClass, ...attributes } = Astro.props;
const Tag = as;
---

<Tag
	class:list={["rounded-2xl border border-stone-300 bg-white shadow-[8px_8px_0_rgba(185,139,62,0.12)]", extraClass]}
	{...attributes}
>
	<slot />
</Tag>
