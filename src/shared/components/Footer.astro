---
import { BLOG_NAME } from "../utils/constants";

import { SUBSTACK_URL, MAIL, INSTAGRAM_URL } from '../utils/constants';
---


	<footer class="border-t border-stone-700 bg-stone-900 text-stone-200">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-6 text-sm max-[600px]:flex-col max-[600px]:items-start lg:px-8">
		<p>&copy; {new Date().getFullYear()} {BLOG_NAME}</p>
		<nav class="flex flex-wrap gap-5" aria-label="Link del footer">
			<a class="transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700" href={`mailto:${MAIL}`}>Email</a>
			<a class="transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700" href={INSTAGRAM_URL} target="_blank" rel="noreferrer">Instagram</a>
			<a class="transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700" href="#" target="_blank" rel="noreferrer">Tiktok</a>
			<a class="transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700" href={SUBSTACK_URL} target="_blank" rel="noreferrer">Substack</a>
		</nav>
	</div>
</footer>
