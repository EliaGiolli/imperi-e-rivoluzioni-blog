---
import { BLOG_AUTHOR, BLOG_NAME, INSTAGRAM_URL, MAIL, SUBSTACK_URL } from "../utils/constants";

const linkClass = "text-ink underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mark";
---

<footer class="page-frame mt-14">
	<div class="rule-t-double flex flex-wrap items-baseline justify-between gap-x-7 gap-y-2.5 pt-[18px] pb-7 text-[13.5px] text-mute">
		<p class="m-0">
			<span class="font-heading text-2xl text-ink">{BLOG_NAME}</span>
			<span class="ml-3">Direttore e redattore: {BLOG_AUTHOR}</span>
		</p>
		<nav aria-label="Contatti e social" class="flex flex-wrap gap-x-5 gap-y-1.5">
			<a class={linkClass} href={`mailto:${MAIL}`}>Email</a>
			<a class={linkClass} href={INSTAGRAM_URL} target="_blank" rel="noreferrer">Instagram</a>
			<a class={linkClass} href={SUBSTACK_URL} target="_blank" rel="noreferrer">Substack</a>
			<a class={linkClass} href="/rss.xml">RSS</a>
		</nav>
		<p class="m-0 basis-full text-[12.5px]">&copy; {new Date().getFullYear()} {BLOG_NAME} · Progetto editoriale indipendente</p>
	</div>
</footer>
