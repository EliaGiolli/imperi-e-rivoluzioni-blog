---
import type { PageHeaderProps } from "../types";

type Props = PageHeaderProps;

const { kicker, title, dek, id } = Astro.props;
---

<header class="mx-auto max-w-[900px] border-b border-ink pt-[clamp(24px,3.4vw,48px)] pb-6 text-center">
	<p class="kicker m-0 text-accent">{kicker}</p>
	<h1 id={id} class="mt-3.5 mb-0 text-[clamp(38px,5.4vw,64px)] font-normal leading-[1.04] tracking-[-0.02em] text-balance">{title}</h1>
	{dek && <p class="mx-auto mt-4 mb-0 max-w-[40em] font-heading text-[clamp(19px,1.9vw,24px)] italic leading-[1.4] text-ink-2 text-pretty">{dek}</p>}
	<slot />
</header>
