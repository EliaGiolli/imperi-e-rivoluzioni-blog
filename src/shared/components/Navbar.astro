---
import { Image } from "astro:assets";
import Button from "../ui/Button.astro";

import Logo from '../assets/I&R logo.png'
import { LOGO_ALT_TEXT, BLOG_NAME } from "../utils/constants";
---

<header
  class="sticky top-0 z-50 border-b border-stone-300 bg-stone-100/85 shadow-[0_10px_30px_rgba(43,38,34,0.08)] backdrop-blur-md"
  x-data="{ open: false }"
  @keydown.escape.window="open = false"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex min-h-19 items-center justify-between gap-4">
      <a
        class="flex items-center gap-3 rounded-full px-2 py-1.5 text-amber-700 no-underline transition-transform duration-200 hover:scale-[1.01] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700 focus-visible:ring-offset-2 focus-visible:ring-offset-stone-100"
        href="/"
        aria-label="Homepage"
      >
        <div class="flex h-12 w-12 items-center justify-center overflow-hidden rounded-full border border-stone-300 bg-white shadow-sm shadow-stone-200">
          <Image src={Logo} width={44} height={44} alt={LOGO_ALT_TEXT} class="h-full w-full object-contain" />
        </div>
        <div class="hidden sm:block">
          <div class="text-sm font-medium uppercase tracking-[0.2em] text-stone-500">Blog</div>
          <div class="text-base font-bold text-amber-700">{BLOG_NAME}</div>
        </div>
        <h1 class="hidden" aria-label="main-title">{BLOG_NAME}</h1>
      </a>

      <nav class="hidden md:block" aria-label="Main navigation">
        <ul class="flex list-none items-center gap-2 p-0">
          <li><a class="rounded-full px-3.5 py-2 text-sm font-semibold text-stone-800 no-underline transition-all duration-200 hover:bg-stone-200 hover:text-stone-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700" href="/articles">Articoli</a></li>
          <li><a class="rounded-full px-3.5 py-2 text-sm font-semibold text-stone-800 no-underline transition-all duration-200 hover:bg-stone-200 hover:text-stone-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700" href="/readings">Letture consigliate</a></li>
          <li><a class="rounded-full px-3.5 py-2 text-sm font-semibold text-stone-800 no-underline transition-all duration-200 hover:bg-stone-200 hover:text-stone-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700" href="/about">Temi</a></li>
          <li><a class="rounded-full bg-amber-700 px-4 py-2.5 text-sm font-semibold text-stone-900 no-underline shadow-sm shadow-stone-200 transition-all duration-200 hover:bg-amber-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700" href="/contacts">Contatti</a></li>
        </ul>
      </nav>

      <div class="md:hidden">
        <Button
          variant="ghost"
          size="sm"
          class="h-11 w-11 rounded-xl border border-stone-300 bg-white p-0 text-amber-700 shadow-sm shadow-stone-200 transition-colors hover:bg-stone-100"
          aria-label="Apri il menu di navigazione"
          :aria-expanded="open.toString()"
          aria-controls="mobile-navigation"
          x-on:click="open = !open"
        >
          <span class="sr-only">Menu</span>
          <span class="flex flex-col gap-1.5" aria-hidden="true">
            <span class="block h-0.5 w-5 rounded-full bg-current transition-transform duration-200" :class="open ? 'translate-y-2 rotate-45' : ''"></span>
            <span class="block h-0.5 w-5 rounded-full bg-current transition-opacity duration-200" :class="open ? 'opacity-0' : ''"></span>
            <span class="block h-0.5 w-5 rounded-full bg-current transition-transform duration-200" :class="open ? '-translate-y-2 -rotate-45' : ''"></span>
          </span>
        </Button>
      </div>
    </div>

    <nav
      id="mobile-navigation"
      class="border-t border-stone-200 py-4 md:hidden"
      x-cloak
      x-show="open"
      x-transition.origin.top.duration.200ms
      @click.outside="open = false"
      aria-label="Mobile navigation"
    >
      <ul class="m-0 flex list-none flex-col gap-1.5 p-0">
        <li><a class="block rounded-2xl px-4 py-3 font-semibold text-stone-800 no-underline transition-colors hover:bg-stone-200 hover:text-stone-900" href="/articles" @click="open = false">Articoli</a></li>
        <li><a class="block rounded-2xl px-4 py-3 font-semibold text-stone-800 no-underline transition-colors hover:bg-stone-200 hover:text-stone-900" href="/readings" @click="open = false">Letture</a></li>
        <li><a class="block rounded-2xl px-4 py-3 font-semibold text-stone-800 no-underline transition-colors hover:bg-stone-200 hover:text-stone-900" href="/about" @click="open = false">Temi</a></li>
        <li><a class="mt-1 block rounded-2xl bg-amber-700 px-4 py-3 font-semibold text-stone-900 no-underline shadow-sm shadow-stone-200 transition-colors hover:bg-amber-600" href="/contacts" @click="open = false">Contatti</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // @ts-expect-error Alpine is used at runtime and its package has no declarations.
  import Alpine from "alpinejs";

  Alpine.start();
</script>
