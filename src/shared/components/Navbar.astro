---
import { getCollection } from "astro:content";
import { byMostRecent, editionOf, formatDate, navLinkCurrent } from "../../core/helpers";
import type { NavbarProps } from "../types";
import { NAV_LINKS } from "../utils/constants";

type Props = NavbarProps;

const { issueSlug } = Astro.props;
const pathname = Astro.url.pathname;

// The ear of the header carries the issue on the page: the article's own on an article,
// the latest one everywhere else.
const articles = await getCollection("articles");
const issue = articles.find((article) => article.data.slug === issueSlug) ?? [...articles].sort(byMostRecent)[0];
const edition = editionOf(issue, articles);
const issueDate = formatDate(issue.data.pubDate);

const FOCUS = "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mark";
---

{/* An empty Alpine scope: without one, Alpine ignores the switch's bindings. */}
<header class="page-frame" x-data>
	<div class="rule-b-double grid min-h-16 grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-3">
		<p class="m-0 text-[13px] text-mute tabular-nums">
			<span class="hidden sm:inline">Anno {edition.yearRoman} · </span>N. {edition.number}<span class="hidden sm:inline"> · {issueDate}</span>
		</p>

		<a
			href="/"
			aria-current={navLinkCurrent(pathname, "/")}
			class={`whitespace-nowrap font-heading text-[clamp(24px,2.6vw,34px)] leading-none tracking-[-0.01em] text-ink no-underline ${FOCUS}`}
		>
			{/* The wordmark: the italic accent "e" is part of the masthead typography. */}
			Imperi <em class="text-accent">e</em> Rivoluzioni
		</a>

		<div class="flex justify-end">
			{/*
				A toggle, not a three-way switch: `aria-pressed` says whether the evening edition
				is on, so the label can stay stable. The knob moves with the `dark` class, which
				the inline head script has already applied by the time this paints.
			*/}
			<button
				type="button"
				aria-label="Edizione della sera"
				aria-pressed="false"
				:aria-pressed="$store.theme.dark.toString()"
				x-on:click="$store.theme.toggle()"
				class={`inline-flex min-h-10 min-w-11 cursor-pointer items-center gap-2 rounded border border-rule bg-transparent px-2.5 text-[13px] font-semibold text-ink hover:border-ink ${FOCUS}`}
			>
				<span aria-hidden="true" class="hidden sm:inline">Sera</span>
				<span aria-hidden="true" class="flex h-4 w-7 items-center justify-start rounded-full border border-ink px-0.5 dark:justify-end">
					<span class="h-2.5 w-2.5 rounded-full bg-ink"></span>
				</span>
			</button>
		</div>
	</div>

	{/* One row at every width: on a phone it scrolls sideways instead of folding into a menu. */}
	<nav aria-label="Sezioni" class="overflow-x-auto border-b border-ink [scrollbar-width:none]">
		<ul class="m-0 flex w-max min-w-full list-none justify-center p-0">
			{NAV_LINKS.map((link) => {
				const current = navLinkCurrent(pathname, link.href);

				return (
					<li class="flex border-l border-rule first:border-l-0">
						<a
							href={link.href}
							aria-current={current}
							class={`flex min-h-11 items-center whitespace-nowrap px-[clamp(6px,1.8vw,22px)] text-[clamp(11px,2.8vw,12.5px)] font-semibold uppercase tracking-[clamp(0.4px,0.14vw,1.75px)] text-ink underline-offset-[5px] hover:underline ${current ? "underline" : "no-underline"} ${FOCUS}`}
						>
							{link.label}
						</a>
					</li>
				);
			})}
		</ul>
	</nav>
</header>

<script>
  // @ts-expect-error Alpine is used at runtime and its package has no declarations.
  import Alpine from "alpinejs";

  const STORAGE_KEY = "theme";
  const systemDark = window.matchMedia("(prefers-color-scheme: dark)");

  /** localStorage throws in some privacy modes, so every access has to tolerate failure. */
  const readChoice = (): string | null => {
    try {
      return localStorage.getItem(STORAGE_KEY);
    } catch {
      return null;
    }
  };

  Alpine.store("theme", {
    dark: readChoice() ? readChoice() === "dark" : systemDark.matches,

    apply() {
      document.documentElement.classList.toggle("dark", this.dark);
    },

    toggle() {
      this.dark = !this.dark;

      try {
        localStorage.setItem(STORAGE_KEY, this.dark ? "dark" : "light");
      } catch {
        // The class still flips for this visit; only the preference is not remembered.
      }

      this.apply();
    },
  });

  // Astro's view transitions copy the incoming document's <html> attributes over the live
  // ones, which drops the class the inline head script set. This listener fires before the
  // new page paints, so re-applying here is what keeps the theme from flashing on navigation.
  document.addEventListener("astro:after-swap", () => Alpine.store("theme").apply());

  // Follow the operating system only until the visitor has made a choice of their own.
  systemDark.addEventListener("change", (event: MediaQueryListEvent) => {
    if (readChoice()) {
      return;
    }

    Alpine.store("theme").dark = event.matches;
    Alpine.store("theme").apply();
  });

  Alpine.start();
</script>
