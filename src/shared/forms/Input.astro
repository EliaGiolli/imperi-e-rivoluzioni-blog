---
import type { InputProps } from "../types";

type Props = InputProps;

const { name, label, type = "text", placeholder, required = false, autocomplete, class: extraClass } = Astro.props;
const inputId = `contact-${name}`;
---

<div class:list={["flex flex-col gap-1.5", extraClass]}>
	<label for={inputId} class="text-[13px] text-mute">
		{label}{required && <span aria-hidden="true"> *</span>}
		{required && <span class="sr-only"> obbligatorio</span>}
	</label>
	{/* Invalid fields keep a red edge: an error signal, not a brand colour, so it stays red in both editions. */}
	<input
		id={inputId}
		name={name}
		type={type}
		placeholder={placeholder}
		required={required}
		autocomplete={autocomplete}
		class="min-h-11.5 w-full rounded border border-field bg-transparent px-3 font-body text-[15px] text-ink placeholder:text-mute focus:outline-2 focus:outline-offset-2 focus:outline-mark aria-invalid:border-red-700 aria-invalid:outline-red-700 dark:aria-invalid:border-red-400"
	/>
</div>
