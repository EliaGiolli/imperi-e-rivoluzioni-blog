---
import type { InputProps } from "../types";

type Props = InputProps;

const { name, label, type = "text", placeholder, required = false, autocomplete, class: extraClass } = Astro.props;
const inputId = `contact-${name}`;
---

<div class:list={["grid gap-2", extraClass]}>
	<label for={inputId} class="text-sm font-bold text-stone-900 dark:text-stone-100">
		{label}{required && <span class="ml-1 text-red-700 dark:text-red-400" aria-hidden="true">*</span>}
		{required && <span class="sr-only"> obbligatorio</span>}
	</label>
	<div class="relative">
		<div class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-red-700 dark:text-amber-500" aria-hidden="true">
			<slot name="icon">•</slot>
		</div>
		<input
			id={inputId}
			name={name}
			type={type}
			placeholder={placeholder}
			required={required}
			autocomplete={autocomplete}
			class="w-full rounded-lg border border-stone-300 bg-stone-100 py-3 pl-9 pr-3 text-stone-900 outline-none transition-colors placeholder:text-stone-400 focus:border-amber-700 focus:ring-2 focus:ring-amber-700/20 aria-invalid:border-red-700 aria-invalid:ring-2 aria-invalid:ring-red-700/25 dark:border-stone-600 dark:bg-stone-900 dark:text-stone-100 dark:placeholder:text-stone-500 dark:focus:border-amber-500 dark:aria-invalid:border-red-400"
		/>
	</div>
</div>
