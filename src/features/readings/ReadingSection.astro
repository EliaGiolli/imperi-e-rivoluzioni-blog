---
import { getCollection } from "astro:content";
import { byMostRecentlyAdded } from "../../core/helpers";
import { HOME_PREVIEW_COUNT } from "../../shared/utils/constants";
import Button from "../../shared/ui/Button.astro";
import Tabs from "../../shared/ui/Tabs.astro";
import TabPanel from "../../shared/ui/TabPanel.astro";
import ReadingCard from "./ReadingCard.astro";

const readings = [...(await getCollection("readings"))].sort(byMostRecentlyAdded).slice(0, HOME_PREVIEW_COUNT);
const tabs = readings.map((reading, index) => ({ id: reading.id, label: `${index + 1}. ${reading.data.name}` }));
---

<section
	id="readings"
	class="border-b border-stone-300 bg-stone-200 dark:border-stone-700 dark:bg-stone-950"
	aria-labelledby="readings-title"
>
	<div class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-24">
		<div class="mb-12 flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
			<div class="max-w-2xl">
				<p class="mb-4 text-sm font-bold uppercase tracking-[0.18em] text-red-700 dark:text-amber-500">Letture consigliate</p>
				<h2 id="readings-title" class="text-3xl font-extrabold tracking-tight text-stone-900 sm:text-4xl dark:text-stone-100">Libri per orientarsi</h2>
				<p class="mt-4 text-lg leading-8 text-stone-700 dark:text-stone-300">
					Le letture più recenti per seguire le connessioni tra imperi, ideologie, conflitti e ordine internazionale.
				</p>
			</div>

			<Button href="/readings" variant="secondary">Tutte le letture</Button>
		</div>

		<Tabs idPrefix="reading" tabs={tabs} ariaLabel="Seleziona una lettura">
			<div class="mt-8">
				{readings.map((reading, index) => (
					<TabPanel idPrefix="reading" id={reading.id} index={index}>
						<ReadingCard reading={reading} />
					</TabPanel>
				))}
			</div>
		</Tabs>
	</div>
</section>
