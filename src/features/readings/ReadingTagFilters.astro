---
import PageHeader from "../../shared/components/PageHeader.astro";
import type { ReadingTagFiltersProps } from "../../shared/types";
import ReadingEntry from "./ReadingEntry.astro";

type Props = ReadingTagFiltersProps;

const { readings, label, title, description } = Astro.props;
const tags = [...new Set(readings.flatMap((reading) => reading.data.tags))].sort((first, second) => first.localeCompare(second, "it"));

// The pressed tag is the page turned over, paper on ink, drawn from aria-pressed alone: Alpine
// only toggles the attribute, so there is no class list for it to merge with the server's.
const TAG = "min-h-10 cursor-pointer rounded border border-rule bg-transparent px-3 text-[13px] font-semibold text-ink-2 hover:border-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mark aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-paper";
---

<div x-data="{ activeTag: 'Tutti' }">
	<PageHeader kicker={label} title={title} dek={description} id="reading-filter-title">
		<nav aria-label="Filtra le letture per tag" class="mt-5">
			<ul class="m-0 flex list-none flex-wrap justify-center gap-2 p-0">
				{["Tutti", ...tags].map((tag) => (
					<li>
						{/* Server-rendered as "Tutti" pressed, so the markup is right before Alpine starts. */}
						<button
							type="button"
							class={TAG}
							aria-pressed={tag === "Tutti" ? "true" : "false"}
							:aria-pressed={`(activeTag === ${JSON.stringify(tag)}).toString()`}
							x-on:click={`activeTag = ${JSON.stringify(tag)}`}
						>
							{tag}
						</button>
					</li>
				))}
			</ul>
		</nav>
	</PageHeader>

	{/*
		No x-cloak: every reading is visible until a tag is chosen, so the list is complete
		before Alpine starts and without JavaScript at all.
	*/}
	<div class="mt-[clamp(24px,3vw,40px)] grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-x-8 gap-y-7" aria-live="polite">
		{readings.map((reading) => (
			<div
				x-data={`{ readingTags: ${JSON.stringify(reading.data.tags)} }`}
				x-show="activeTag === 'Tutti' || readingTags.includes(activeTag)"
				class="grid"
			>
				<ReadingEntry reading={reading} headingLevel="h2" />
			</div>
		))}
	</div>
</div>
