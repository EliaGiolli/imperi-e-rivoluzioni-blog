---
import Input from "../../shared/forms/Input.astro";
import Form from "../../shared/forms/Form.astro";
import SectionHeading from "../../shared/components/SectionHeading.astro";
import Button from "../../shared/ui/Button.astro";

const emailJs = {
	serviceId: import.meta.env.PUBLIC_EMAILJS_SERVICE_ID ?? "",
	templateId: import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID ?? "",
	publicKey: import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY ?? "",
};
---

<section id="contact" aria-labelledby="contact-title">
	<SectionHeading id="contact-title" kicker="Supporto tecnico" title="Lettere alla redazione" />

	<div class="mt-4.5 flex flex-wrap gap-x-12 gap-y-5">
		<div class="min-w-0 flex-[1_1_280px]">
			<p class="m-0 font-heading text-2xl italic leading-[1.3]">Qualcosa non funziona sul sito?</p>
			<p class="mt-2.5 mb-0 text-justify text-[15px] leading-[1.65] text-ink-2 hyphens-auto">
				Scrivi alla redazione. Anche un problema piccolo, come un menu che non si vede sul telefono, è un buon punto da cui iniziare.
			</p>
			<p class="mt-3 mb-0 text-[13px] text-mute">I campi con * sono obbligatori.</p>
		</div>

		<Form
			id="contact-form"
			serviceId={emailJs.serviceId}
			templateId={emailJs.templateId}
			publicKey={emailJs.publicKey}
			class="grid min-w-0 flex-[2_1_420px] grid-cols-[repeat(auto-fit,minmax(min(100%,200px),1fr))] gap-x-4.5 gap-y-3.5"
		>
			<Input name="from_name" label="Nome" autocomplete="name" required />
			<Input name="reply_to" label="Email" type="email" autocomplete="email" required />
			<Input name="subject" label="Oggetto" required />
			<div class="col-span-full flex flex-col gap-1.5">
				<label for="contact-message" class="text-[13px] text-mute">Messaggio<span aria-hidden="true"> *</span><span class="sr-only"> obbligatorio</span></label>
				<textarea
					id="contact-message"
					name="message"
					rows="4"
					required
					class="resize-y rounded border border-field bg-transparent px-3 py-2.5 font-body text-[15px] leading-normal text-ink focus:outline-2 focus:outline-offset-2 focus:outline-mark aria-invalid:border-red-700 aria-invalid:outline-red-700 dark:aria-invalid:border-red-400"
				></textarea>
			</div>
			<div class="col-span-full flex flex-wrap items-center gap-4">
				<Button type="submit" variant="secondary"><span data-submit-label>Invia la lettera</span></Button>
				<p id="contact-status" class="m-0 text-sm text-mute" role="status" aria-live="polite"></p>
			</div>
		</Form>
	</div>
</section>

<script>
	import emailjs from "@emailjs/browser";
	import type { ContactField } from "../../shared/types";
	import { contactErrorSummary, validateContactForm } from "../../core/helpers";

	const FIELDS: ContactField[] = ["from_name", "reply_to", "subject", "message"];

	const forms = document.querySelectorAll<HTMLFormElement>("[data-contact-form]");

	forms.forEach((form) => {
		const status = form.querySelector<HTMLElement>("#contact-status");
		const submitLabel = form.querySelector<HTMLElement>("[data-submit-label]");
		const controlFor = (field: ContactField) =>
			form.elements.namedItem(field) as HTMLInputElement | HTMLTextAreaElement | null;

		const emailJsConfigured = Boolean(form.dataset.serviceId && form.dataset.templateId && form.dataset.publicKey);

		// The EmailJS path never reaches the browser's own validation, so take it over
		// entirely rather than leaving the fields unchecked.
		if (emailJsConfigured) {
			form.noValidate = true;
		}

		const clearInvalid = (field: ContactField) => {
			controlFor(field)?.removeAttribute("aria-invalid");
		};

		FIELDS.forEach((field) => {
			controlFor(field)?.addEventListener("input", () => clearInvalid(field));
		});

		form.addEventListener("submit", async (event) => {
			if (!emailJsConfigured) {
				if (status) status.textContent = "Si aprirà il tuo client email per completare l'invio.";
				return;
			}

			event.preventDefault();

			const values = Object.fromEntries(FIELDS.map((field) => [field, controlFor(field)?.value ?? ""]));
			const errors = validateContactForm(values);

			FIELDS.forEach(clearInvalid);

			if (errors.length > 0) {
				errors.forEach(({ field }) => controlFor(field)?.setAttribute("aria-invalid", "true"));
				if (status) status.textContent = contactErrorSummary(errors);
				controlFor(errors[0].field)?.focus();
				return;
			}

			if (status) status.textContent = "Invio in corso...";
			if (submitLabel) submitLabel.textContent = "Invio...";

			try {
				await emailjs.sendForm(form.dataset.serviceId!, form.dataset.templateId!, form, {
					publicKey: form.dataset.publicKey!,
				});
				form.reset();
				if (status) status.textContent = "Messaggio inviato. Grazie, ti risponderò presto.";
			} catch {
				if (status) status.textContent = "Invio non riuscito. Puoi scrivermi direttamente via email.";
			} finally {
				if (submitLabel) submitLabel.textContent = "Invia la lettera";
			}
		});
	});
</script>
