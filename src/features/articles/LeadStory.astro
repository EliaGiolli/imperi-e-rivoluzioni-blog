---
import { Image } from "astro:assets";
import { formatDate } from "../../core/helpers";
import Button from "../../shared/ui/Button.astro";
import type { LeadStoryProps } from "../../shared/types";

type Props = LeadStoryProps;

const { article, series, paragraphs } = Astro.props;
const { data } = article;
const href = `/articles/${data.slug}`;

const kicker = series.total > 1 ? `${series.name}, parte ${series.part.roman}` : data.topic;
---

<article aria-labelledby="lead-title" class="min-w-0 flex-[2_1_560px]">
	<p class="kicker m-0 text-accent">In primo piano · {kicker}</p>
	<h2 id="lead-title" class="mt-3 mb-0 text-[clamp(34px,4.4vw,58px)] font-normal leading-[1.02] tracking-[-0.015em] text-balance">
		<a href={href} class="text-ink no-underline decoration-1 underline-offset-8 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mark">{data.title}</a>
	</h2>
	<p class="mt-3.5 mb-0 font-heading text-[clamp(19px,1.8vw,23px)] italic leading-[1.4] text-ink-2 text-pretty">{data.description}</p>
	<p class="mt-4 mb-0 flex flex-wrap gap-x-4 gap-y-1.5 border-y border-rule py-2 text-[13px] text-mute">
		<span>di <strong class="font-semibold text-ink">{data.author}</strong></span>
		<time datetime={data.pubDate.toISOString().slice(0, 10)}>{formatDate(data.pubDate)}</time>
		<span>{data.topic}</span>
	</p>

	{data.cover && (
		<figure class="mt-[18px] mb-0">
			{/* Never enlarged past its own width: a small archive photo stays sharp, just smaller. */}
			<div class="border border-ink bg-paper p-1" style={`max-width: ${data.cover.width + 10}px`}>
				<Image src={data.cover} alt={data.coverAlt ?? ""} class="block h-auto w-full contrast-[1.12] grayscale" widths={[data.cover.width]} sizes={`(min-width: 960px) ${Math.min(data.cover.width, 760)}px, 100vw`} />
			</div>
			{(data.coverCaption || data.coverCredit) && (
				<figcaption class="mt-2 flex flex-wrap justify-between gap-x-4 gap-y-1 border-b border-rule pb-2 text-[13.5px] italic leading-[1.45] text-ink-2">
					{data.coverCaption && <span>{data.coverCaption}</span>}
					{data.coverCredit && <span class="text-xs not-italic text-mute">{data.coverCredit}</span>}
				</figcaption>
			)}
		</figure>
	)}

	<div class="drop-cap mt-[18px] columns-[2_260px] gap-8 text-justify text-[15.5px] leading-[1.65] text-ink-2 hyphens-auto [column-rule:1px_solid_var(--gz-rule)]">
		{paragraphs.map((paragraph) => <p class="mt-0 mb-3">{paragraph}</p>)}
	</div>

	<Button href={href} variant="primary" class="mt-2">Continua a leggere <span aria-hidden="true">→</span></Button>
</article>
