---
import type { ArticleCardProps } from "../../shared/types";
import Card from "../../shared/ui/Card.astro";

type Props = ArticleCardProps;

const { article, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
---

<Card as="article" class="flex h-full flex-col p-6 lg:p-8" aria-labelledby={`article-card-title-${article.data.slug}`}>
	<p class="text-sm font-bold uppercase tracking-[0.16em] text-red-700 dark:text-amber-500">Articolo</p>
	<Heading id={`article-card-title-${article.data.slug}`} class="mt-3 text-2xl font-extrabold text-stone-900 dark:text-stone-100">{article.data.title}</Heading>
	<p class="mt-4 grow text-base leading-7 text-stone-700 dark:text-stone-300">{article.data.description}</p>

	<ul class="mt-6 flex flex-wrap gap-2" aria-label={`Argomenti di ${article.data.title}`}>
		{article.data.tags.map((tag) => (
			<li class="rounded-md border border-stone-300 bg-stone-100 px-3 py-1 text-sm font-medium text-stone-700 dark:border-stone-600 dark:bg-stone-700 dark:text-stone-200">{tag}</li>
		))}
	</ul>

	<a
		href={`/articles/${article.data.slug}`}
		class="mt-8 inline-flex items-center gap-2 border-t border-stone-200 pt-5 font-semibold text-red-700 underline-offset-4 transition-colors hover:text-red-800 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700 focus-visible:ring-offset-2 dark:border-stone-700 dark:text-amber-500 dark:hover:text-amber-400"
	>
		<span>Leggi l'articolo</span>
		<span aria-hidden="true">→</span>
	</a>
</Card>
