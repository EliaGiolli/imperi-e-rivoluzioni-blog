---
import Card from "../../shared/ui/Card.astro";

interface Props {
	article: {
		id: string;
		data: {
			title: string;
			description: string;
			tags: string[];
			slug: string;
		};
	};
}

const { article } = Astro.props;
---

<Card as="article" class="flex h-full flex-col bg-white p-6 lg:p-8" aria-labelledby={`article-card-title-${article.data.slug}`}>
	<p class="text-sm font-bold uppercase tracking-[0.16em] text-red-700">Articolo</p>
	<h4 id={`article-card-title-${article.data.slug}`} class="mt-3 text-2xl font-extrabold text-stone-900">{article.data.title}</h4>
	<p class="mt-4 grow text-base leading-7 text-stone-700">{article.data.description}</p>

	<ul class="mt-6 flex flex-wrap gap-2" aria-label={`Argomenti di ${article.data.title}`}>
		{article.data.tags.map((tag) => (
			<li class="rounded-md border border-stone-300 bg-stone-100 px-3 py-1 text-sm font-medium text-stone-700">{tag}</li>
		))}
	</ul>

	<a
		href={`/articles/${article.data.slug}`}
		class="mt-8 inline-flex items-center gap-2 border-t border-stone-200 pt-5 font-semibold text-red-700 underline-offset-4 transition-colors hover:text-red-800 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700 focus-visible:ring-offset-2"
	>
		<span>Leggi l'articolo</span>
		<span aria-hidden="true">→</span>
	</a>
</Card>
