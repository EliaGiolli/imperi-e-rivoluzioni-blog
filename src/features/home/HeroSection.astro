---
import Button from "../../shared/ui/Button.astro";

const techGroups = [
	{
		label: "Domande",
		icon: "▣",
		items: "Il potere · Le crisi · Il cambiamento",
	},
	{
		label: "Connessioni",
		icon: "⌁",
		items: "Eventi · Persone · Ideologie · Stati",
	},
	{
		label: "Lungo XX secolo",
		icon: "▤",
		items: "Dalla fine dell'Ottocento alla Guerra fredda",
	},
	{
		label: "Fonti e letture",
		icon: "$_",
		items: "Storia · Geopolitica · Più lingue",
	},
];
---

<section
	id="hero"
	class="relative overflow-hidden border-b border-stone-700 bg-stone-900 text-white"
	aria-labelledby="hero-title"
>
	<div class="mx-auto grid max-w-6xl gap-14 px-6 py-24 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:px-8 lg:py-32">
		<div class="max-w-3xl">
			<p class="mb-6 flex items-center gap-3 text-sm font-bold uppercase tracking-[0.18em] text-amber-700">
				<span class="h-px w-8 bg-amber-700" aria-hidden="true"></span>
				Progetto editoriale indipendente
			</p>
			<h1 id="hero-title" class="max-w-3xl text-4xl font-extrabold tracking-tight text-white sm:text-6xl lg:text-7xl">
				Imperi e rivoluzioni.
			</h1>
			<p class="mt-6 max-w-2xl text-xl font-medium leading-8 text-stone-200 sm:text-2xl">
				Storia, potere e geopolitica per comprendere il mondo contemporaneo attraverso le sue radici.
			</p>
			<p class="mt-5 max-w-2xl text-base leading-7 text-stone-300">
				Partiamo da domande, ricostruiamo connessioni e distinguiamo fatti, interpretazioni storiografiche e questioni ancora aperte.
			</p>

			<div class="mt-8 flex flex-wrap gap-4">
				<Button href="/articles" variant="primary" size="lg" class="hero-primary" aria-label="Leggi gli articoli di storia e geopolitica">
					<span aria-hidden="true">↗</span>
					<span>Leggi gli articoli</span>
				</Button>
				<Button href="/readings" variant="secondary" size="lg" class="hero-secondary" aria-label="Esplora fonti e letture di storia contemporanea">
					<span aria-hidden="true">⌘</span>
					<span>Scopri la bibliografia</span>
				</Button>
			</div>
		</div>

		<aside class="rounded-2xl border border-white/10 bg-white/5 p-6 sm:p-8" aria-labelledby="tech-stack-title">
			<div class="mb-6 flex items-center gap-3">
				<span class="text-2xl text-amber-700" aria-hidden="true">✦</span>
				<h2 id="tech-stack-title" class="text-2xl font-bold text-white">Una mappa per orientarsi</h2>
			</div>
			<p class="mb-6 text-sm leading-6 text-stone-300">
				Un percorso tra storia contemporanea, relazioni internazionali e letture per capire il presente.
			</p>
			<ul class="grid gap-4" aria-label="Temi principali del progetto editoriale">
				{techGroups.map((group, index) => (
					<li class="flex gap-3 border-t border-white/10 pt-4">
						<span class="mt-0.5 font-mono text-sm text-amber-700" aria-hidden="true">0{index + 1}</span>
						<div>
							<h3 class="font-semibold text-white">{group.label}</h3>
							<p class="mt-1 text-sm text-stone-300">{group.items}</p>
						</div>
					</li>
				))}
			</ul>
		</aside>
	</div>
</section>