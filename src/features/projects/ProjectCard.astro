---
import Card from "../../shared/ui/Card.astro";

interface Props {
	title: string;
	tags: string[];
	slug: string;
	githubUrl: string;
}

const { title, tags, slug, githubUrl }: Props = Astro.props;
---

<Card as="article" class="flex min-h-96 flex-col bg-[#f6f4ee] p-6 lg:p-8" aria-labelledby={`project-card-title-${slug}`}>
	<div class="flex items-start justify-between gap-6">
		<div class="flex items-center gap-3">
			<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#f2b84b] text-2xl text-[#17252b]" aria-hidden="true">
				<slot name="icon">◈</slot>
			</div>
			<div>
				<p class="text-sm font-bold uppercase tracking-[0.16em] text-indigo-600">Progetto</p>
				<h3 id={`project-card-title-${slug}`} class="mt-1 text-2xl font-extrabold text-[#17252b]">{title}</h3>
			</div>
		</div>
	</div>

	<div class="mt-6 grow text-base leading-7 text-slate-600">
		<slot />
	</div>

	<ul class="mt-6 flex flex-wrap gap-2" aria-label={`Tecnologie usate in ${title}`}>
		{tags.map((tag: string) => (
			<li class="rounded-md border border-[#d9d6cb] bg-white px-3 py-1 text-sm font-medium text-slate-700">{tag}</li>
		))}
	</ul>

	<div class="mt-8 flex flex-wrap items-center gap-5 border-t border-slate-200 pt-5">
		<a
			href={`/projects/${slug}`}
			class="inline-flex items-center gap-2 font-semibold text-indigo-600 underline-offset-4 transition-colors hover:text-violet-600 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2"
		>
			<span>Dettagli del progetto</span>
			<span aria-hidden="true">→</span>
		</a>
		{githubUrl && (
			<a
				href={githubUrl}
				target="_blank"
				rel="noreferrer"
				class="inline-flex items-center gap-2 font-semibold text-slate-700 underline-offset-4 transition-colors hover:text-indigo-600 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2"
			>
				<span aria-hidden="true">↗</span>
				<span>Repository GitHub</span>
			</a>
		)}
	</div>
</Card>