---
import { getCollection, render } from "astro:content";
import MainLayout from "../../core/layouts/MainLayout.astro";
import { formatDate, readingTime } from "../../core/helpers";

export async function getStaticPaths() {
	const articles = await getCollection("articles");

	return articles.map((article) => ({
		params: { id: article.data.slug },
		props: { article },
	}));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);

const minutes = readingTime(article.body ?? "");
const toIsoDate = (date: Date): string => date.toISOString().slice(0, 10);

// Only the section level matters for the outline: H1 is the page title, H4+ is detail.
const tableOfContents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<MainLayout title={article.data.title} description={article.data.description}>
	<main class="mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-24">
		<a href="/articles" class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.18em] text-red-700 hover:text-red-800">
			<span aria-hidden="true">←</span>
			<span>Torna agli articoli</span>
		</a>

		<div class="mt-8 lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:items-start lg:gap-10">
			{tableOfContents.length > 0 && (
				<nav
					class="mb-8 rounded-2xl border border-stone-300 bg-white p-5 lg:sticky lg:top-24 lg:mb-0"
					aria-labelledby="toc-title"
				>
					<p id="toc-title" class="font-dispatch text-sm uppercase tracking-[0.16em] text-stone-600">Indice</p>
					<ol class="mt-4 max-h-64 space-y-2 overflow-y-auto pr-1 text-sm lg:max-h-[65vh]" role="list">
						{tableOfContents.map((heading) => (
							<li class={heading.depth === 3 ? "pl-4" : ""}>
								<a
									href={`#${heading.slug}`}
									class="block rounded-md px-2 py-1 leading-6 text-stone-700 transition-colors hover:bg-stone-100 hover:text-red-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700"
								>
									{heading.text}
								</a>
							</li>
						))}
					</ol>
				</nav>
			)}

			<article class="rounded-2xl border border-stone-300 bg-white p-8 shadow-[6px_6px_0_rgba(185,139,62,0.12)] sm:p-10">
				<p class="text-sm font-bold uppercase tracking-[0.18em] text-red-700">{article.data.topic}</p>
				<h1 class="mt-4 text-4xl font-extrabold tracking-tight text-stone-900 sm:text-5xl">{article.data.title}</h1>
				<p class="mt-4 text-xl font-semibold text-amber-700">{article.data.category}</p>
				<p class="mt-6 text-lg leading-8 text-stone-700">{article.data.description}</p>

				<ul class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 font-dispatch text-sm uppercase tracking-[0.12em] text-stone-600" aria-label="Dettagli dell'articolo">
					<li>{article.data.author}</li>
					<li aria-hidden="true">·</li>
					<li>
						<time datetime={toIsoDate(article.data.pubDate)}>{formatDate(article.data.pubDate)}</time>
					</li>
					{article.data.updatedDate && (
						<>
							<li aria-hidden="true">·</li>
							<li>
								Aggiornato il <time datetime={toIsoDate(article.data.updatedDate)}>{formatDate(article.data.updatedDate)}</time>
							</li>
						</>
					)}
					{minutes > 0 && (
						<>
							<li aria-hidden="true">·</li>
							<li>{minutes} min di lettura</li>
						</>
					)}
				</ul>

				<ul class="mt-6 flex flex-wrap gap-2" aria-label={`Argomenti di ${article.data.title}`}>
					{article.data.tags.map((tag: string) => (
						<li class="rounded-md border border-stone-300 bg-stone-100 px-3 py-1 text-sm font-medium text-stone-700">{tag}</li>
					))}
				</ul>

				<div class="prose prose-lg mx-auto mt-10">
					<Content />
				</div>
			</article>
		</div>
	</main>
</MainLayout>
