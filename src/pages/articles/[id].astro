---
import { getCollection, render } from "astro:content";
import MainLayout from "../../core/layouts/MainLayout.astro";
import { buildArticleSchema, formatDate, readingTime } from "../../core/helpers";
import { BLOG_NAME, OG_IMAGE_PATH } from "../../shared/utils/constants";

export async function getStaticPaths() {
	const articles = await getCollection("articles");

	return articles.map((article) => ({
		params: { id: article.data.slug },
		props: { article },
	}));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);

const minutes = readingTime(article.body ?? "");
const toIsoDate = (date: Date): string => date.toISOString().slice(0, 10);

// Only the section level matters for the outline: H1 is the page title, H4+ is detail.
const tableOfContents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
// Trailing slash to match the canonical, the sitemap and the RSS feed.
const articleUrl = new URL(`/articles/${article.data.slug}/`, siteUrl).href;

const articleSchema = buildArticleSchema({
	title: article.data.title,
	description: article.data.description,
	author: article.data.author,
	pubDate: article.data.pubDate,
	updatedDate: article.data.updatedDate,
	tags: article.data.tags,
	url: articleUrl,
	imageUrl: new URL(OG_IMAGE_PATH, siteUrl).href,
	blogName: BLOG_NAME,
	siteUrl: siteUrl.href,
});
---

<MainLayout
	title={article.data.title}
	description={article.data.description}
	ogType="article"
	publishedTime={article.data.pubDate}
	modifiedTime={article.data.updatedDate ?? article.data.pubDate}
>
	<script
		slot="head"
		type="application/ld+json"
		is:inline
		set:html={JSON.stringify(articleSchema)}
	/>

	<main class="mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-24">
		<a href="/articles" class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.18em] text-red-700 hover:text-red-800 dark:text-amber-500 dark:hover:text-amber-400">
			<span aria-hidden="true">←</span>
			<span>Torna agli articoli</span>
		</a>

		<div class="mt-8 lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:items-start lg:gap-10">
			{tableOfContents.length > 0 && (
				<nav
					class="mb-8 rounded-2xl border border-stone-300 bg-white p-5 lg:sticky lg:top-24 lg:mb-0 dark:border-stone-700 dark:bg-stone-800"
					aria-labelledby="toc-title"
				>
					<p id="toc-title" class="font-dispatch text-sm uppercase tracking-[0.16em] text-stone-600 dark:text-stone-400">Indice</p>
					<ol class="mt-4 max-h-64 space-y-2 overflow-y-auto pr-1 text-sm lg:max-h-[65vh]" role="list">
						{tableOfContents.map((heading) => (
							<li class={heading.depth === 3 ? "pl-4" : ""}>
								<a
									href={`#${heading.slug}`}
									class="block rounded-md px-2 py-1 leading-6 text-stone-700 transition-colors hover:bg-stone-100 hover:text-red-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700 dark:text-stone-300 dark:hover:bg-stone-700 dark:hover:text-amber-400"
								>
									{heading.text}
								</a>
							</li>
						))}
					</ol>
				</nav>
			)}

			<article class="rounded-2xl border border-stone-300 bg-white p-8 shadow-[6px_6px_0_rgba(185,139,62,0.12)] sm:p-10 dark:border-stone-700 dark:bg-stone-800">
				<p class="text-sm font-bold uppercase tracking-[0.18em] text-red-700 dark:text-amber-500">{article.data.topic}</p>
				<h1 class="mt-4 text-4xl font-extrabold tracking-tight text-stone-900 sm:text-5xl dark:text-stone-100">{article.data.title}</h1>
				<p class="mt-4 text-xl font-semibold text-amber-800 dark:text-amber-500">{article.data.category}</p>
				<p class="mt-6 text-lg leading-8 text-stone-700 dark:text-stone-300">{article.data.description}</p>

				<ul class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 font-dispatch text-sm uppercase tracking-[0.12em] text-stone-600 dark:text-stone-400" aria-label="Dettagli dell'articolo">
					<li>{article.data.author}</li>
					<li aria-hidden="true">·</li>
					<li>
						<time datetime={toIsoDate(article.data.pubDate)}>{formatDate(article.data.pubDate)}</time>
					</li>
					{article.data.updatedDate && (
						<>
							<li aria-hidden="true">·</li>
							<li>
								Aggiornato il <time datetime={toIsoDate(article.data.updatedDate)}>{formatDate(article.data.updatedDate)}</time>
							</li>
						</>
					)}
					{minutes > 0 && (
						<>
							<li aria-hidden="true">·</li>
							<li>{minutes} min di lettura</li>
						</>
					)}
				</ul>

				<ul class="mt-6 flex flex-wrap gap-2" aria-label={`Argomenti di ${article.data.title}`}>
					{article.data.tags.map((tag: string) => (
						<li class="rounded-md border border-stone-300 bg-stone-100 px-3 py-1 text-sm font-medium text-stone-700 dark:border-stone-600 dark:bg-stone-700 dark:text-stone-200">{tag}</li>
					))}
				</ul>

				<div class="prose prose-lg mx-auto mt-10">
					<Content />
				</div>
			</article>
		</div>
	</main>
</MainLayout>
