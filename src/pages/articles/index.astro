---
import MainLayout from "../../core/layouts/MainLayout.astro";

const posts = [
	{
		id: "first-post",
		title: "First blog post",
		description: "A sample placeholder article to demonstrate the blog route structure.",
		publishedAt: "2026-09-07",
	},
	{
		id: "second-post",
		title: "Second blog post",
		description: "Use this page to list future writings, tutorials, and notes.",
		publishedAt: "2026-09-08",
	},
];
---

<MainLayout>
	<main class="mx-auto max-w-5xl px-6 py-16 lg:px-8">
		<p class="text-sm font-bold uppercase tracking-[0.2em] text-red-700">Blog</p>
		<h1 class="mt-4 text-4xl font-extrabold tracking-tight text-stone-900 sm:text-5xl">Latest posts</h1>
		<p class="mt-6 max-w-3xl text-lg leading-8 text-stone-700">
			This is the placeholder blog index page. Replace the sample entries with real blog content later.
		</p>

		<div class="mt-12 grid gap-6">
			{posts.map((post) => (
				<article class="rounded-2xl border border-stone-300 bg-white p-6 shadow-[6px_6px_0_rgba(185,139,62,0.12)]">
					<p class="text-sm font-semibold uppercase tracking-[0.14em] text-amber-700">{post.publishedAt}</p>
					<h2 class="mt-3 text-2xl font-bold text-stone-900">{post.title}</h2>
					<p class="mt-3 text-stone-700">{post.description}</p>
					<a href={`/blog/${post.id}`} class="mt-5 inline-flex font-semibold text-red-700 underline-offset-4 hover:text-red-800 hover:underline">
						Read more →
					</a>
				</article>
			))}
		</div>
	</main>
</MainLayout>
