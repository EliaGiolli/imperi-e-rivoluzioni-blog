---
import { Image } from "astro:assets";

import MainLayout from "../core/layouts/MainLayout.astro";
import PageHeader from "../shared/components/PageHeader.astro";
import SectionHeading from "../shared/components/SectionHeading.astro";
import Button from "../shared/ui/Button.astro";

import graduationPhoto from "../features/home/assets/foto-laurea.jpg";
import { INSTAGRAM_URL, SUBSTACK_URL } from "../shared/utils/constants";

const pillars = [
	{
		title: "Cosa racconto",
		body: "Il lungo XX secolo e le sue eredità: imperialismo e nazionalismi, guerre mondiali, rivoluzioni, fascismi, nazismo, comunismo, URSS e Guerra fredda, fino alle linee di frattura della geopolitica di oggi.",
	},
	{
		title: "Come lavoro",
		body: "Parto da una domanda, non da una tesi. Confronto le fonti, tengo separati i fatti accertati, le interpretazioni storiografiche e le questioni ancora aperte, e cito ciò su cui mi appoggio.",
	},
	{
		title: "Cosa non troverai",
		body: "Nessun titolo acchiappa-clic, nessuna lista superficiale, nessuna lezione morale sul passato. Testi lunghi, argomentati e pensati per essere letti con calma, anche quando la risposta è \"non lo sappiamo\".",
	},
];
---

<MainLayout
	title="Chi sono"
	description="Chi c'è dietro Imperi e Rivoluzioni: un progetto indipendente di divulgazione storica sul lungo XX secolo, tra imperi, rivoluzioni, autoritarismi e geopolitica contemporanea."
>
	<main class="page-frame">
		<PageHeader
			kicker="Il progetto"
			title="Chi sono e perché scrivo"
			dek="Imperi e Rivoluzioni è un progetto indipendente di ricerca e divulgazione storica. Nasce da una convinzione semplice: quasi nessuna crisi contemporanea è davvero inedita, e per capirla bisogna risalire alle strutture di potere che l'hanno resa possibile."
		/>

		<section aria-labelledby="bio-title" class="mt-[clamp(28px,3.4vw,44px)] grid gap-x-12 gap-y-8 md:grid-cols-[minmax(0,320px)_minmax(0,1fr)]">
			<figure class="m-0">
				<div class="border border-ink bg-paper p-[5px]">
					<Image
						src={graduationPhoto}
						alt="Elia Giolli durante la cerimonia di laurea"
						class="block aspect-4/5 h-auto w-full object-cover contrast-[1.05] sepia-[.15]"
						width={640}
						height={800}
						loading="lazy"
					/>
				</div>
				<figcaption class="mt-2 border-b border-rule pb-2 text-sm italic leading-[1.45] text-ink-2">
					Una formazione linguistica per leggere la storia oltre i confini nazionali.
				</figcaption>
			</figure>

			<div class="border-t border-ink pt-3.5">
				<h2 id="bio-title" class="m-0 text-[clamp(28px,3vw,38px)] font-normal leading-[1.1]">Studiare, collegare, sintetizzare</h2>
				<div class="drop-cap mt-4 space-y-4 text-justify text-[17px] leading-[1.75] text-ink-2 hyphens-auto">
					<p>
						Mi chiamo Elia e sono laureato in lingue e letterature straniere. Non mi presento come uno storico
						che sa tutto, ma come un autore e ricercatore indipendente: studio, collego e sintetizzo con serietà
						ciò che altri hanno ricostruito prima di me, per restituirlo in una forma leggibile.
					</p>
					<p>
						Le lingue sono lo strumento che mi permette di allargare il campo e di non fermarmi a una sola
						tradizione storiografica: leggo e parlo inglese, russo, spagnolo, tedesco, cinese, giapponese e
						polacco. È il modo più diretto per verificare come uno stesso evento venga raccontato da chi lo ha
						vissuto da parti opposte.
					</p>
					<p>
						Mi interessano soprattutto le storie strutturali e poco battute: come una democrazia viene svuotata
						dall'interno, come un apparato militare diventa il vero centro dello Stato, come una transizione
						autoritaria si prepara per decenni prima di manifestarsi. Il Giappone Meiji e Shōwa, la Germania di
						Weimar, gli autoritarismi tra le due guerre sono il punto di partenza di questi cicli.
					</p>
				</div>
			</div>
		</section>

		<section aria-labelledby="mission-title" class="mt-[clamp(32px,4vw,56px)]">
			<SectionHeading id="mission-title" kicker="Il metodo" title="La linea editoriale" />
			<div class="mt-5 grid gap-x-10 gap-y-6 md:grid-cols-3">
				{pillars.map((pillar) => (
					<article class="border-t border-ink pt-3.5 md:border-t-0 md:border-l md:border-rule md:pt-0 md:pl-6 md:first:border-l-0 md:first:pl-0">
						<h3 class="m-0 text-2xl font-semibold leading-[1.2]">{pillar.title}</h3>
						<p class="mt-2 mb-0 text-justify text-[15.5px] leading-[1.65] text-ink-2 hyphens-auto">{pillar.body}</p>
					</article>
				))}
			</div>
		</section>

		<section aria-labelledby="follow-title" class="rule-double mx-auto mt-[clamp(32px,4vw,56px)] max-w-[780px] p-[clamp(20px,3vw,34px)] text-center">
			<p class="kicker m-0 text-accent">Instagram · il blog · Substack</p>
			<h2 id="follow-title" class="mt-2 mb-0 text-[clamp(28px,3vw,38px)] font-normal leading-[1.1]">Dove continua il discorso</h2>
			<p class="mx-auto mt-2.5 mb-0 max-w-[36em] text-[15px] leading-[1.6] text-ink-2">
				Il percorso parte dalla scoperta su Instagram, prosegue con gli approfondimenti di questo blog e arriva
				alle letture e alle riflessioni più personali su Substack: tre luoghi diversi per costruire nel tempo una
				forma mentis storica.
			</p>
			<div class="mt-5 flex flex-wrap items-center justify-center gap-3">
				<Button href="/articles" variant="primary">Leggi gli articoli</Button>
				<Button href={INSTAGRAM_URL} variant="secondary" target="_blank" rel="noreferrer">Instagram</Button>
				<Button href={SUBSTACK_URL} variant="secondary" target="_blank" rel="noreferrer">Substack</Button>
				<Button href="/contacts" variant="ghost">Scrivimi</Button>
			</div>
		</section>
	</main>
</MainLayout>
