---
import MainLayout from "../core/layouts/MainLayout.astro";
---

<MainLayout>
	<main class="mx-auto max-w-5xl px-6 py-16 lg:px-8">
		<p class="text-sm font-bold uppercase tracking-[0.2em] text-red-700">About</p>
		<h1 class="mt-4 text-4xl font-extrabold tracking-tight text-stone-900 sm:text-5xl">This is a placeholder About page.</h1>
		<p class="mt-6 max-w-3xl text-lg leading-8 text-stone-700">
			Use this section to describe who you are, what you do, and the mission behind the project.
		</p>

		<div class="mt-12 grid gap-6 md:grid-cols-3">
			<article class="rounded-2xl border border-stone-300 bg-white p-6 shadow-[6px_6px_0_rgba(185,139,62,0.12)]">
				<h2 class="text-xl font-bold text-stone-900">Profile</h2>
				<p class="mt-3 text-stone-700">Short bio and personal overview for visitors.</p>
			</article>
			<article class="rounded-2xl border border-stone-300 bg-white p-6 shadow-[6px_6px_0_rgba(185,139,62,0.12)]">
				<h2 class="text-xl font-bold text-stone-900">Focus</h2>
				<p class="mt-3 text-stone-700">A summary of your technical specialties and interests.</p>
			</article>
			<article class="rounded-2xl border border-stone-300 bg-white p-6 shadow-[6px_6px_0_rgba(185,139,62,0.12)]">
				<h2 class="text-xl font-bold text-stone-900">Values</h2>
				<p class="mt-3 text-stone-700">A few principles that shape your approach and work.</p>
			</article>
		</div>
	</main>
</MainLayout>
