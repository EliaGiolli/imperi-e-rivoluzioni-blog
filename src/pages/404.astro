---
import { Image } from "astro:assets";
import image404 from '../shared/assets/404.png';

import MainLayout from "../core/layouts/MainLayout.astro";
import Button from "../shared/ui/Button.astro";
---

<MainLayout>
    <Button href="/" variant="primary" class="mx-10 mt-10">Torna alla home</Button>
    <div class="flex flex-col items-center justify-items-center gap-7">
        <Image 
            src={image404}
            width={250} 
            height={200} 
            alt="Un cartello giallo simile a quello per i lavori con la scritta 404"
        />
        <h1 class="text-5xl text-red-700">404 - Pagina non trovata</h1>
        <p class="text-2xl mb-10 text-stone-700">
            Mi dispiace, ma non siamo riusciti a trovare la pagina che stai cercando
        </p>

    </div>

</MainLayout>