---
import MainLayout from "../core/layouts/MainLayout.astro";
import PageHeader from "../shared/components/PageHeader.astro";
import Button from "../shared/ui/Button.astro";
---

<MainLayout
	title="Pagina non trovata"
	description="La pagina che cercavi non esiste o è stata spostata. Torna alla home di Imperi e Rivoluzioni per riprendere la navigazione."
	noindex
>
	<main class="page-frame">
		<PageHeader
			kicker="Errata corrige · 404"
			title="Pagina non trovata"
			dek="Questa pagina non è mai andata in stampa, oppure è stata spostata in un altro numero."
		/>
		<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
			<Button href="/" variant="primary">Torna alla prima pagina</Button>
			<Button href="/articles" variant="secondary">Sfoglia l'archivio</Button>
		</div>
	</main>
</MainLayout>
