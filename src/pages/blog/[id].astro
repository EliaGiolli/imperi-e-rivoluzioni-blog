---
import MainLayout from "../../core/layouts/MainLayout.astro";

const { id } = Astro.params;

const posts = {
	"first-post": {
		title: "First blog post",
		publishedAt: "2026-09-07",
		content: [
			"This is a placeholder article for the blog detail route.",
			"Replace this content with your real article body, headings, and media.",
			"The route is ready to be connected to a CMS, a markdown collection, or a custom data source.",
		],
	},
	"second-post": {
		title: "Second blog post",
		publishedAt: "2026-09-08",
		content: [
			"This second entry shows how the dynamic blog detail route can render multiple posts.",
			"Structure your article data in a list or collection and pass it into this template.",
			"You can then customize the layout for each post as needed.",
		],
	},
};

const post = posts[id as keyof typeof posts];

if (!post) {
	throw new Error(`Post not found: ${id}`);
}
---

<MainLayout>
	<main class="mx-auto max-w-4xl px-6 py-16 lg:px-8">
		<a href="/blog" class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.18em] text-red-700 hover:text-red-800">
			← Back to blog
		</a>

		<article class="mt-8 rounded-2xl border border-stone-300 bg-white p-8 shadow-[6px_6px_0_rgba(185,139,62,0.12)] sm:p-10">
			<p class="text-sm font-bold uppercase tracking-[0.18em] text-amber-700">{post.publishedAt}</p>
			<h1 class="mt-4 text-4xl font-extrabold tracking-tight text-stone-900 sm:text-5xl">{post.title}</h1>

			<div class="mt-8 space-y-5 text-lg leading-8 text-stone-700">
				{post.content.map((paragraph) => <p>{paragraph}</p>)}
			</div>
		</article>
	</main>
</MainLayout>
