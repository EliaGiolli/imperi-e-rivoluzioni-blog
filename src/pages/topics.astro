---
import { getCollection } from "astro:content";

import MainLayout from "../core/layouts/MainLayout.astro";
import { buildThemeIndex } from "../core/helpers";
import PageHeader from "../shared/components/PageHeader.astro";
import SectionHeading from "../shared/components/SectionHeading.astro";

const [articles, readings] = await Promise.all([getCollection("articles"), getCollection("readings")]);
const { topics, tags } = buildThemeIndex(articles, readings);

const countLabel = (articleCount: number, readingCount: number): string =>
	[
		articleCount > 0 ? `${articleCount} ${articleCount === 1 ? "articolo" : "articoli"}` : null,
		readingCount > 0 ? `${readingCount} ${readingCount === 1 ? "lettura" : "letture"}` : null,
	]
		.filter(Boolean)
		.join(" · ");

const LINK = "underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mark";
---

<MainLayout
	title="Temi: articoli e letture per argomento"
	description="L'indice tematico di Imperi e Rivoluzioni: articoli e letture consigliate raccolti per percorso storico e per tag, da imperi e nazionalismi al Medio Oriente, dal Giappone all'URSS."
>
	<main class="page-frame">
		<PageHeader
			kicker="Temi"
			title="L'indice dei percorsi"
			dek="Ogni tema raccoglie gli articoli e le letture che lo attraversano, per seguire un filo storico per intero invece di leggere un pezzo alla volta."
		>
			<nav aria-label="Vai a un tema" class="mt-5">
				<ul class="m-0 flex list-none flex-wrap justify-center gap-x-5 gap-y-2 p-0 text-sm">
					{topics.map((topic) => (
						<li>
							<a href={`#tema-${topic.slug}`} class={`font-semibold text-accent ${LINK}`}>
								{topic.name}<span class="font-normal text-mute" aria-hidden="true"> ({topic.entries.length})</span>
							</a>
						</li>
					))}
				</ul>
			</nav>
		</PageHeader>

		<section aria-labelledby="paths-title" class="mt-[clamp(28px,3.4vw,44px)]">
			<SectionHeading id="paths-title" kicker="Per tema" title="Percorsi" />

			<div class="mt-5 grid gap-x-12 gap-y-10 lg:grid-cols-2">
				{topics.map((topic) => (
					<article id={`tema-${topic.slug}`} aria-labelledby={`tema-${topic.slug}-title`} class="border-t border-ink pt-3.5">
						<div class="flex flex-wrap items-baseline justify-between gap-3">
							<h3 id={`tema-${topic.slug}-title`} class="m-0 text-[28px] font-normal leading-[1.15]">{topic.name}</h3>
							<p class="kicker m-0 text-mute">{countLabel(topic.articleCount, topic.readingCount)}</p>
						</div>

						<ul class="mt-3 mb-0 list-none p-0">
							{topic.entries.map((entry) => (
								<li class="border-t border-rule py-3 first:border-t-0">
									<p class="kicker m-0 text-accent">{entry.kind === "article" ? "Articolo" : "Lettura"} · {entry.subtitle}</p>
									<a href={entry.href} class={`mt-1 inline-block font-heading text-xl leading-[1.2] font-semibold text-ink ${LINK}`}>{entry.title}</a>
									<p class="mt-1 mb-0 text-justify text-[15px] leading-[1.6] text-ink-2 hyphens-auto">{entry.description}</p>
								</li>
							))}
						</ul>

						<ul class="mt-2 mb-0 flex list-none flex-wrap gap-x-4 gap-y-1 p-0" aria-label={`Tag del tema ${topic.name}`}>
							{topic.tags.map((tag) => <li class="kicker text-mute">{tag}</li>)}
						</ul>
					</article>
				))}
			</div>
		</section>

		<section aria-labelledby="tag-index-title" class="mt-[clamp(32px,4vw,56px)]">
			<SectionHeading id="tag-index-title" kicker="Dalla A alla Z" title="Indice analitico" />
			<p class="mt-2 mb-0 text-sm text-mute">Tutti i tag usati nel blog, in ordine alfabetico, con i testi che li trattano.</p>

			<dl class="mt-5 mb-0 columns-[3_240px] gap-10 [column-rule:1px_solid_var(--gz-rule)]">
				{tags.map((tag) => (
					<div class="mb-5 break-inside-avoid">
						<dt class="flex flex-wrap items-baseline justify-between gap-2 border-b border-rule pb-1">
							<span class="font-heading text-lg font-semibold">{tag.name}</span>
							<span class="text-xs text-mute">{countLabel(tag.articleCount, tag.readingCount)}</span>
						</dt>
						<dd class="m-0 mt-1.5">
							<ul class="m-0 list-none space-y-1 p-0">
								{tag.entries.map((entry) => (
									<li><a href={entry.href} class={`text-sm leading-snug text-ink-2 hover:text-ink ${LINK}`}>{entry.title}</a></li>
								))}
							</ul>
						</dd>
					</div>
				))}
			</dl>
		</section>
	</main>
</MainLayout>
