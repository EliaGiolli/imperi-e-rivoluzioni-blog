---
import { getCollection } from "astro:content";
import MainLayout from "../core/layouts/MainLayout.astro";
import ReadingTagFilters from "../features/readings/ReadingTagFilters.astro";

const readings = await getCollection("readings");
---

<MainLayout
	title="Temi | Letture di storia e geopolitica | Imperi e Rivoluzioni"
	description="Esplora le letture di Imperi e Rivoluzioni per tema: imperi, nazionalismi, conflitti, Medio Oriente, Giappone, URSS e Guerra fredda."
>
	<main>
		<ReadingTagFilters
			readings={readings}
			label="Temi"
			title="Scegli una prospettiva"
			description="Filtra la bibliografia per argomento e segui i fili che collegano imperi, nazionalismi, conflitti e trasformazioni dell'ordine internazionale."
		/>
	</main>
</MainLayout>
