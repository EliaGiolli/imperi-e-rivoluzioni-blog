---
import { getCollection } from "astro:content";
import MainLayout from "../../core/layouts/MainLayout.astro";
import ReadingTagFilters from "../../features/readings/ReadingTagFilters.astro";

const readings = await getCollection("readings");
---

<MainLayout
	title="Letture consigliate"
	description="La bibliografia di Imperi e Rivoluzioni: libri di storia contemporanea e geopolitica per orientarsi tra imperi, nazionalismi, conflitti e ordine internazionale."
>
	<main>
		<ReadingTagFilters
			readings={readings}
			label="Bibliografia"
			title="Letture per capire il presente"
			description="Libri per orientarsi tra storia contemporanea, imperi, nazionalismi, conflitti e trasformazioni dell'ordine internazionale."
		/>
	</main>
</MainLayout>
