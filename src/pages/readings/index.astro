---
import { getCollection } from "astro:content";
import MainLayout from "../../core/layouts/MainLayout.astro";
import ReadingCard from "../../features/readings/ReadingCard.astro";

const readings = await getCollection("readings");
---

<MainLayout>
	<main class="mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-24">
		<p class="text-sm font-bold uppercase tracking-[0.2em] text-red-700">Bibliografia</p>
		<h1 class="mt-4 text-4xl font-extrabold tracking-tight text-stone-900 sm:text-5xl">Letture per capire il presente</h1>
		<p class="mt-6 max-w-3xl text-lg leading-8 text-stone-700">
			Libri per orientarsi tra storia contemporanea, imperi, nazionalismi, conflitti e trasformazioni dell'ordine internazionale.
		</p>

		<div class="mt-12 grid gap-6 md:grid-cols-2">
			{readings.map((reading) => <ReadingCard reading={reading} />)}
		</div>
	</main>
</MainLayout>
