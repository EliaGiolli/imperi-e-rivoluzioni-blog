---
import { getCollection, render } from "astro:content";
import MainLayout from "../../core/layouts/MainLayout.astro";
import PageHeader from "../../shared/components/PageHeader.astro";
import Button from "../../shared/ui/Button.astro";

export async function getStaticPaths() {
	const readings = await getCollection("readings");

	return readings.map((reading) => ({
		params: { id: reading.id },
		props: { reading },
	}));
}

const { reading } = Astro.props;
const { data } = reading;
const { Content } = await render(reading);
---

<MainLayout
	title={`${data.name} — ${data.author}`}
	description={data.description}
>
	<main class="page-frame">
		<article>
			<PageHeader kicker={`Letture consigliate · ${data.topic}`} title={data.name} dek={data.description}>
				<p class="mt-4 mb-0 text-[13.5px] text-mute">di <strong class="font-semibold text-ink">{data.author}</strong></p>
			</PageHeader>

			<div class="prose prose-lg mx-auto mt-[clamp(24px,3vw,40px)] max-w-170">
				<Content />
			</div>

			<div class="mx-auto mt-8 max-w-170 border-t border-rule pt-5">
				<ul class="m-0 flex list-none flex-wrap gap-x-4 gap-y-1 p-0 text-[13px] text-mute" aria-label={`Argomenti di ${data.name}`}>
					{data.tags.map((tag) => <li class="kicker">{tag}</li>)}
				</ul>
				<div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3">
					<Button href={data.amazonUrl} variant="primary" target="_blank" rel="noreferrer">
						Vedi il libro su Amazon<span aria-hidden="true"> ↗</span><span class="sr-only"> (sito esterno)</span>
					</Button>
					<a href="/readings" class="text-sm font-semibold text-accent underline-offset-4 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mark">
						<span aria-hidden="true">← </span>Tutte le letture
					</a>
				</div>
			</div>
		</article>
	</main>
</MainLayout>
