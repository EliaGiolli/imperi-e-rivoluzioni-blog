---
import MainLayout from "../core/layouts/MainLayout.astro";
import ContactMe from "../features/contact/ContactMe.astro";
import SubscribeBox from "../features/home/SubscribeBox.astro";
import PageHeader from "../shared/components/PageHeader.astro";
---

<MainLayout
	title="Contatti e supporto tecnico"
	description="Contattami per supporto tecnico e assistenza su problemi tecnici. Racconta il problema e ricevi un primo orientamento."
>
	<main class="page-frame">
		<PageHeader
			id="contacts-title"
			kicker="Contatti"
			title="Mettiamo in ordine il problema."
			dek="Una lettera alla redazione per qualcosa che non funziona, o un'email ogni volta che esce un nuovo numero."
		/>

		<div class="mt-[clamp(28px,3.4vw,44px)]">
			<ContactMe />
		</div>

		<div class="mt-[clamp(32px,4vw,52px)]">
			<SubscribeBox />
		</div>
	</main>
</MainLayout>
