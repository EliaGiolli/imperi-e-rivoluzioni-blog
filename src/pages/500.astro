---
import type { ServerErrorPageProps } from "../shared/types";
import MainLayout from "../core/layouts/MainLayout.astro";
import PageHeader from "../shared/components/PageHeader.astro";
import Button from "../shared/ui/Button.astro";

type Props = ServerErrorPageProps;

const { error } = Astro.props;

// The raw message is never rendered to visitors: it only reaches the server logs.
if (import.meta.env.DEV && error instanceof Error) {
	console.error(error);
}
---

<MainLayout
	title="Errore del server"
	noindex
	description="Si è verificato un errore imprevisto. Torna alla home di Imperi e Rivoluzioni e riprova la navigazione."
>
	<main class="page-frame">
		<PageHeader
			kicker="Errata corrige · 500"
			title="Errore del server"
			dek="Qualcosa si è inceppato in tipografia e non siamo riusciti a completare la richiesta. L'errore è stato registrato: se il problema persiste, scrivici pure."
		/>
		<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
			<Button href="/" variant="primary">Torna alla prima pagina</Button>
			<Button href="/contacts" variant="secondary">Segnala il problema</Button>
		</div>
	</main>
</MainLayout>
