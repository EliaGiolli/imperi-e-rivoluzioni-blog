---
import MainLayout from "../../core/layouts/MainLayout.astro";

const historyEntries = [
	{
		id: "journey-start",
		title: "The beginning",
		description: "A placeholder overview of the start of the story.",
		publishedAt: "2026-09-07",
	},
	{
		id: "next-step",
		title: "The next step",
		description: "A placeholder for the next chapter in the timeline.",
		publishedAt: "2026-09-08",
	},
];
---

<MainLayout>
	<main class="mx-auto max-w-5xl px-6 py-16 lg:px-8">
		<p class="text-sm font-bold uppercase tracking-[0.2em] text-red-700">History</p>
		<h1 class="mt-4 text-4xl font-extrabold tracking-tight text-stone-900 sm:text-5xl">Timeline</h1>
		<p class="mt-6 max-w-3xl text-lg leading-8 text-stone-700">
			This is a placeholder history index page. Add your milestones, events, and narrative timeline here.
		</p>

		<div class="mt-12 space-y-6">
			{historyEntries.map((entry) => (
				<article class="rounded-2xl border border-stone-300 bg-white p-6 shadow-[6px_6px_0_rgba(185,139,62,0.12)]">
					<p class="text-sm font-semibold uppercase tracking-[0.14em] text-amber-700">{entry.publishedAt}</p>
					<h2 class="mt-3 text-2xl font-bold text-stone-900">{entry.title}</h2>
					<p class="mt-3 text-stone-700">{entry.description}</p>
					<a href={`/history/${entry.id}`} class="mt-5 inline-flex font-semibold text-red-700 underline-offset-4 hover:text-red-800 hover:underline">
						Read timeline entry →
					</a>
				</article>
			))}
		</div>
	</main>
</MainLayout>
